# Fluorite Labs — Environment Template
# This file defines expected environment variable names and placeholders.
# NEVER commit real credentials, passwords, connection strings, or secret keys here.

# ==========================================
# Public / Client-Side (Prefixed with VITE_)
# ==========================================
VITE_SITE_URL=http://localhost:5173
VITE_CLERK_PUBLISHABLE_KEY=

# ==========================================
# Server-Side / Secrets (Cloudflare Worker Env)
# ==========================================
NODE_ENV=development
DATABASE_URL=
CLERK_SECRET_KEY=
ADMIN_CLERK_USER_ID=
