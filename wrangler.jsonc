{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fluoritelabs",
  "compatibility_date": "2026-09-25",
  "main": "./workers/app.ts",
  "assets": {
    "directory": "./build/client",
  },
  "observability": {
    "enabled": true,
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "fluoritelabs-media",
    },
  ],
}
